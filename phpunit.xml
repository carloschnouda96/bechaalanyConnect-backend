<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!--
            Tests run against a real MySQL database, NOT sqlite :memory:.

            About 15 of the 64 tables were generated by the hellotree CMS and have no
            migration at all, so `migrate:fresh` cannot build a working schema and
            RefreshDatabase is unusable. The bootstrap source of truth is
            database/dumps/schema.sql; migrations are the delta on top of it.

            Create the test database once with:
                php artisan test:prepare-db

            tests/TestCase.php uses DatabaseTransactions, so each test rolls back.
        -->
        <env name="DB_DATABASE" value="bconnect_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!--
            Live supplier credentials must not reach the suite, whatever .env holds.
            Tests that need a connector configured set it with config() and Http::fake().
        -->
        <env name="YASSEN_SYNC_ENABLED" value="false" force="true"/>
        <env name="ALLOSHAREJLE_SYNC_ENABLED" value="false" force="true"/>
        <env name="SWIFT_SYNC_ENABLED" value="false" force="true"/>
        <env name="ONEXPANEL_SYNC_ENABLED" value="false" force="true"/>
        <env name="USHAREZ_SYNC_ENABLED" value="false" force="true"/>
        <env name="UMANAGE_SYNC_ENABLED" value="false" force="true"/>
        <env name="BYCEL_SYNC_ENABLED" value="false" force="true"/>
        <env name="YASSEN_API_TOKEN" value="" force="true"/>
        <env name="ALLOSHAREJLE_API_TOKEN" value="" force="true"/>
        <env name="SWIFT_API_KEY" value="" force="true"/>
        <env name="ONEXPANEL_API_KEY" value="" force="true"/>
        <env name="USHAREZ_API_KEY" value="" force="true"/>
        <env name="UMANAGE_API_KEY" value="" force="true"/>
        <env name="UMANAGE_API_SECRET" value="" force="true"/>
        <env name="BYCEL_API_KEY" value="" force="true"/>
    </php>
</phpunit>
