APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Defaults to false so a copy-paste deploy cannot ship a debug-mode API. With
# APP_DEBUG=true, any 500 on an Accept: application/json request returns the full
# stack trace, absolute filesystem paths and framework internals to the caller.
# Turn it on locally if you want the trace.
APP_DEBUG=false
APP_URL=http://localhost

# Public origin of the Next.js storefront. Used for OAuth redirects and as the
# fallback CORS origin.
APP_FRONT_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# `database` so supplier fulfillment runs out-of-band. With `sync`,
# FulfillSupplierOrderJob executes inline inside the admin's approve request: the
# CMS response blocks on a third-party HTTP call, and the job's $tries/$backoff
# are inert because a sync job never retries. Requires a worker
# (`php artisan queue:work`) or the /api/cron/queue/work endpoint.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# MUST be true in production. The CMS admin panel is cookie-authenticated, and
# without this the session cookie is sent over plain HTTP.
SESSION_SECURE_COOKIE=false

# Comma-separated list of browser origins allowed to call /api/*. Was hardcoded
# to "*". Falls back to APP_FRONT_URL when unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sanctum token lifetime in minutes (default 30 days). Previously tokens never
# expired, so a leaked one stayed valid forever.
SANCTUM_EXPIRATION=43200

# Google OAuth. GOOGLE_CLIENT_ID is REQUIRED for Google sign-in: it is the
# audience that /api/auth/google-sync checks each ID token against. Without it
# that endpoint fails closed and Google sign-in is disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Supplier integrations. Tokens/keys are secrets — set them in .env only, never
# commit a real value. Each *_SYNC_ENABLED master switch keeps the sync commands
# and order auto-fulfillment no-ops until turned on.
YASSEN_BASE_URL=https://api.yassen-card.com
YASSEN_API_TOKEN=
YASSEN_SYNC_ENABLED=false
YASSEN_QTY_MULTIPLIER=1

SWIFT_BASE_URL=https://swiftservices.store
SWIFT_API_KEY=
SWIFT_SYNC_ENABLED=false

# 1xpanel (Perfect Panel v2). Env prefix is ONEXPANEL_ (not 1XPANEL_) so the
# names are exportable by POSIX shells / Docker / Forge.
ONEXPANEL_BASE_URL=https://1xpanel.com
ONEXPANEL_API_KEY=
ONEXPANEL_SYNC_ENABLED=false

# usharez (Bearer-token header auth). Two product families behind one account:
# quota bundles and Alfa Gifts, each with its own switch. Quota prices arrive in
# LBP, so USHAREZ_LBP_PER_USD converts them for the USD-only storefront — Fixed
# Settings (usharez_lbp_per_usd) overrides it when an admin sets it in the CMS.
USHAREZ_BASE_URL=https://bechaalanyconnect.usharez.com
USHAREZ_API_KEY=
USHAREZ_SYNC_ENABLED=false
USHAREZ_LBP_PER_USD=89500
USHAREZ_QUOTA_ENABLED=true
USHAREZ_GIFTS_ENABLED=true
# 'national8' keeps the operator's leading zero (03123456);
# 'strip_leading_zero' sends 3123456.
USHAREZ_PHONE_FORMAT=national8

# U-Manage (dual-header auth: X-API-Key + X-API-Secret). Five product families
# across bundles / SMS / telecom. Leave UMANAGE_STORE_ID empty to auto-discover
# the first linked store from GET /stores. Rate limit: 1000 requests/hour.
UMANAGE_BASE_URL=https://api.umanageapp.uk/api/v1/external
UMANAGE_API_KEY=
UMANAGE_API_SECRET=
UMANAGE_STORE_ID=
UMANAGE_SYNC_ENABLED=false
UMANAGE_BUNDLES_ENABLED=true
UMANAGE_SMS_ENABLED=true
UMANAGE_TELECOM_ENABLED=true

# Bycel / Power Group. Auth is the single InApiKey header — AND the calling
# server's egress IP must be whitelisted by Power Group, the only supplier with
# that requirement. Test keys are prefixed TEST_. Bycel ships its own FX rate on
# every catalog row, so it ignores LBP_PER_USD.
# Not importable from this API: alfa_sms_services (no price, no purchase endpoint),
# alfa_days_products (no purchase endpoint), alfa/touch credit transfers (no
# published cost).
BYCEL_BASE_URL=https://www.bycel.app/OutAPIV1/
BYCEL_API_KEY=
BYCEL_SYNC_ENABLED=false
BYCEL_VOUCHERS_ENABLED=true
BYCEL_RECHARGE_ENABLED=true

# Shared LBP→USD divisor for every supplier that quotes in Lebanese Pounds.
# Fixed Settings (lbp_per_usd) overrides this from the CMS.
LBP_PER_USD=89500

# Shared secret for the HTTP cron entrypoints (/api/cron/*). REQUIRED — the
# endpoints return 503 while it is empty, because each hit runs a full
# multi-supplier sync in-process and would otherwise be an anonymous way to pin
# PHP-FPM workers and burn the suppliers' rate-limited API quotas.
# The host's wget cron passes it as ?token=<this> or an X-Cron-Token header.
# Generate one with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
CRON_TOKEN=
