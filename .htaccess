# Laravel is served from public/. If this project ever sits under a web root (MAMP's
# htdocs does exactly that), nothing above public/ may be readable: .env, .git, storage,
# database dumps. public/.htaccess turns its own rewrite engine on, so these rules do not
# reach it. mod_rewrite is what Laravel already requires here.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ - [F,L]
</IfModule>

# Without mod_rewrite the rule above does nothing, so deny outright rather than serve files.
# Laravel needs mod_rewrite, so public/ loses nothing by inheriting this on such a host.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
